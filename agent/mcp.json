{
  "mcpServers": {
    "binlog": {
      "command": "dotnet",
      "args": [
        "dnx",
        "Microsoft.AITools.BinlogMcp",
        "--yes",
        "--prerelease"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    }
  }
}
